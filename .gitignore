# Build output
/bin/
/dist/
/optimizer
/koctl
/experiment
/workload-gen
*.test
*.out

# Python analysis environment
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Generated experiment data.
#
# What is committed, and why:
#
#   experiments/results/*.csv.gz            the evidence behind every figure
#   experiments/results/*.provenance.json   how each run was produced
#
# Together these are a few megabytes and are everything needed to check a figure
# or reproduce a run, so they are version-controlled deliberately.
#
# The full JSON archive (*.json) repeats the same records with provenance attached
# and is roughly forty times larger — 128 MB across the suite. It is written only
# with `-archive-json` and is not committed; `make experiments` regenerates
# everything in about two minutes.
experiments/results/*.json
!experiments/results/*.provenance.json
experiments/results/*.csv

